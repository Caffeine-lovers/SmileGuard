# Patient Web Portal Environment Variables Template
# Copy this file to .env.local and fill in the values

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modal inference server configuration
NEXT_PUBLIC_SMILEGUARD_ENDPOINT=https://your-workspace--smileguard-predict.modal.run
SMILEGUARD_ENDPOINT=https://your-workspace--smileguard-predict.modal.run

# Stripe Integration Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
