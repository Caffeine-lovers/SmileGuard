# Patient Web Portal Environment Variables Template
# Copy this file to .env.local and fill in the values

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Modal inference server configuration
NEXT_PUBLIC_SMILEGUARD_ENDPOINT=https://your-workspace--smileguard-predict.modal.run
SMILEGUARD_ENDPOINT=https://your-workspace--smileguard-predict.modal.run

# PayMongo Payment Gateway Configuration (BSP-licensed)
PAYMONGO_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_your_public_key_here
PAYMONGO_WEBHOOK_SECRET=whsec_your_webhook_secret_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

